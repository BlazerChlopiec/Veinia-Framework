<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<PublishReadyToRun>false</PublishReadyToRun>
		<TieredCompilation>false</TieredCompilation>
		<IncludeContentInPack>false</IncludeContentInPack>
		<PackageId>Veinia</PackageId>
    	<Version>1.0.2</Version>
	</PropertyGroup>
	<PropertyGroup>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Icon.ico</ApplicationIcon>
		<StartupObject />
	</PropertyGroup>
	<ItemGroup>
		<None Remove="Icon.ico" />
		<None Remove="Icon.bmp" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="Icon.ico" />
		<EmbeddedResource Include="Icon.bmp" />
	</ItemGroup>
	<ItemGroup>
		<MonoGameContentReference Include="Source\Content\Content.mgcb" />
	</ItemGroup>
	<ItemGroup>
		<TrimmerRootAssembly Include="Microsoft.Xna.Framework.Content.ContentTypeReader" Visible="false" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Aether.Physics2D.Diagnostics.MG" Version="2.2.0" ExcludeAssets="contentFiles" />
		<PackageReference Include="Aether.Physics2D.MG" Version="2.2.0" />
		<PackageReference Include="LibTessDotNet" Version="1.1.15" />
		<PackageReference Include="MonoGame.Extended.Particles" Version="3.8.0" />
		<PackageReference Include="MonoGame.Extended.Tweening" Version="3.8.0" />
		<PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
		<PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5-preview.4" />
		<PackageReference Include="Myra" Version="1.5.11" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="GeonBit.UI.DataTypes">
			<HintPath>Source\Content\GeonBit.UI.DataTypes.dll</HintPath>
		</Reference>
	</ItemGroup>
	<Target Name="RestoreDotnetTools" BeforeTargets="Restore">
		<Message Text="Restoring dotnet tools" Importance="High" />
		<Exec Command="dotnet tool restore" />
	</Target>
	
	<Target Name="EmbedContent" AfterTargets="RunContentBuilder" BeforeTargets="CoreCompile">
		<ItemGroup>
			<EmbeddedResource Include="@(ExtraContent)">
				<LogicalName>%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
			</EmbeddedResource>
		</ItemGroup>
	</Target>
</Project>